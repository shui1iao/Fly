# 安装测试版
curl -fsSL https://sing-box.app/install.sh | sh -s -- --beta
# 安装指定版本
curl -fsSL https://sing-box.app/install.sh | sh -s -- --version 1.12.0
#生成配置证书
mkdir -p /etc/sing-box/certs
openssl ecparam -genkey -name prime256v1 -out /etc/sing-box/certs/private.key
openssl req -new -x509 -days 36500 -key /etc/sing-box/certs/private.key -out /etc/sing-box/certs/cert.pem -subj "/CN=bing.com"
#编辑配置文件
{
  "inbounds": [
    {
      "type": "anytls",
      "tag": "节点",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "password": "密码" 
        }
      ],
      "padding_scheme": [],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/certs/cert.pem",
        "key_path": "/etc/sing-box/certs/private.key"
      }
    }
  ]
}

sudo systemctl start sing-box
sudo systemctl enable sing-box
sudo systemctl status sing-box
