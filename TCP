echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
sysctl -p

iperf3 -c IP -R -t 15

nano /etc/sysctl.conf

net.ipv4.tcp_wmem = 4096 16384 67108864
net.ipv4.tcp_rmem = 4096 87380 67108864
sysctl -p

ip a

tc qdisc del dev eth0 root
tc qdisc add dev eth0 root handle 1:0 htb default 10

tc class add dev eth0 parent 1:0 classid 1:1 htb rate 900mbit ceil 900mbit
tc filter add dev eth0 protocol ip parent 1:0 prio 1 u32 match ip src 0.0.0.0/0 flowid 1:1
tc class add dev eth0 parent 1:0 classid 1:2 htb rate 900mbit ceil 900mbit
tc filter add dev eth0 protocol ip parent 1:0 prio 1 u32 match ip dst 0.0.0.0/0 flowid 1:2

tc qdisc show dev eth0
tc class show dev eth0
tc -s filter show dev eth0

nano /etc/rc.local

#!/bin/bash
# rc.local
# 本文件将在系统启动时执行
# 在此处添加你希望开机执行的命令：
tc qdisc add dev eth0 root handle 1:0 htb default 10
tc class add dev eth0 parent 1:0 classid 1:1 htb rate 900mbit ceil 900mbit
tc filter add dev eth0 protocol ip parent 1:0 prio 1 u32 match ip src 0.0.0.0/0 flowid 1:1
tc class add dev eth0 parent 1:0 classid 1:2 htb rate 900mbit ceil 900mbit
tc filter add dev eth0 protocol ip parent 1:0 prio 1 u32 match ip dst 0.0.0.0/0 flowid 1:2
exit 0
