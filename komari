<script>
(() => {
  const CFG = {
    refreshMs: 30000,
    hideUnlimited: true,
    matchCardSelector: '.rounded-lg.border.text-card-foreground',
    nameSelector: 'p.font-bold.text-xs',
    insertBeforeSelector: 'section.flex.gap-1.items-center.flex-wrap',
    recentConcurrency: 4,
    epsilonPct: 0.2,
    debug: false,
  };

  const log = (...a) => CFG.debug && console.log('[traffic]', ...a);
  const q  = (el, sel) => el.querySelector(sel);
  const qa = (el, sel) => Array.from(el.querySelectorAll(sel));

  /* ===== 工具函数 ===== */
  const fmtBytes = n => {
    if (!Number.isFinite(n)) return '-';
    const u = ['B','KiB','MiB','GiB','TiB','PiB'];
    let v = Number(n), i = 0;
    while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
    return v.toFixed(v < 10 ? 2 : v < 100 ? 1 : 0) + ' ' + u[i];
  };
  const calcUsed = (type, up, down) => {
    switch ((type || 'sum').toLowerCase()) {
      case 'up':  return up;
      case 'down':return down;
      case 'max': return Math.max(up, down);
      case 'min': return Math.min(up, down);
      default:    return up + down;
    }
  };
  const typeLabel = t => ({sum:'双向',up:'出向',down:'入向',max:'最大',min:'最小'})[(t||'sum').toLowerCase()] || t;
  const colorOf = pct => pct >= 90 ? 'var(--km-traffic-bad)'
                     : pct >= 50 ? 'var(--km-traffic-warn)'
                                  : 'var(--km-traffic-ok)';

  const snap = {
    get: (name) => { try { return JSON.parse(sessionStorage.getItem('km-traffic:' + name) || 'null'); } catch { return null; } },
    set: (name, obj) => { try { sessionStorage.setItem('km-traffic:' + name, JSON.stringify(obj)); } catch {} },
    del: (name) => { try { sessionStorage.removeItem('km-traffic:' + name); } catch {} }
  };

  async function jget(url){ const r = await fetch(url, { credentials: 'include' }); if (!r.ok) throw new Error(url + ' ' + r.status); return r.json(); }
  const getCardName = el => (q(el, CFG.nameSelector)?.textContent || '').trim();
  const findInsertBefore = el => q(el, CFG.insertBeforeSelector) || qa(el, 'section').pop() || el.lastElementChild || el;

  function pLimit(n){const q=[];let a=0;const run=async(f,res,rej)=>{a++;try{res(await f());}catch(e){rej(e);}finally{a--;if(q.length){const nx=q.shift();run(nx.fn,nx.res,nx.rej);}}};return fn=>new Promise((res,rej)=>{if(a<n)run(fn,res,rej);else q.push({fn,res,rej});});}
  const limitRecent = pLimit(CFG.recentConcurrency);

  let nodesCache=null,nodesCacheAt=0;
  const priming=jget('/api/nodes').then(r=>r).catch(()=>null);
  async function getNodes(force=false){
    const now=Date.now();
    if(!force&&nodesCache&&(now-nodesCacheAt<8000))return nodesCache;
    const res=await(nodesCache?jget('/api/nodes'):(await priming||jget('/api/nodes')));
    nodesCache=(res?.data||[]);nodesCacheAt=now;return nodesCache;
  }

  async function getUsedFromRecent(uuid){
    const rec=await jget(`/api/recent/${encodeURIComponent(uuid)}`);
    const arr=rec?.data||[];const last=arr[arr.length-1]||{};const net=last?.network||{};
    return {up:Number(net.totalUp||0),down:Number(net.totalDown||0)};
  }

  function ensureWrap(card,anchor){
    let wrap=q(card,'.km-traffic-wrap');
    if(!wrap){wrap=document.createElement('div');wrap.className='km-traffic-wrap w-full mt-1';anchor?.parentNode?.insertBefore(wrap,anchor);}
    else if(wrap.parentNode!==anchor?.parentNode){anchor?.parentNode?.insertBefore(wrap,anchor);}
    return wrap;
  }

  function setSkeleton(wrap){
    wrap.innerHTML='';
    const shell=document.createElement('div');
    shell.className='km-traffic-shell km-traffic-skeleton';
    wrap.appendChild(shell);
    const label=document.createElement('div');
    label.className='km-traffic-label';
    label.innerHTML=`<span>加载中…</span><span>—</span>`;
    wrap.appendChild(label);
    wrap.dataset.pct='';
  }

  function renderBar(wrap,info){
    const pct=Math.max(0,Math.min(100,info.percent));
    const prev=Number(wrap.dataset.pct||NaN);
    const minor=Number.isFinite(prev)&&Math.abs(prev-pct)<CFG.epsilonPct;

    if(!minor){
      wrap.innerHTML='';
      const shell=document.createElement('div');
      shell.className='km-traffic-shell';
      const bar=document.createElement('div');
      bar.className='km-traffic-bar';
      bar.style.width=pct.toFixed(2)+'%';
      bar.style.background=colorOf(pct);
      const label=document.createElement('div');
      label.className='km-traffic-label';
      label.innerHTML=`<span>${info.typeTxt}：${info.usedTxt} / ${info.limitTxt}</span><span>${pct.toFixed(1)}%</span>`;
      shell.appendChild(bar);wrap.appendChild(shell);wrap.appendChild(label);
    }else{
      const bar=q(wrap,'.km-traffic-bar');
      if(bar){bar.style.width=pct.toFixed(2)+'%';bar.style.background=colorOf(pct);}
      const pctText=q(wrap,'.km-traffic-label span:last-child');
      if(pctText)pctText.textContent=`${pct.toFixed(1)}%`;
    }
    wrap.dataset.pct=pct.toString();
  }

  /* ===== 渲染主逻辑 ===== */
  let rendering=false;
  async function renderOnce(){
    if(rendering)return;
    rendering=true;
    try{
      const cards=qa(document,CFG.matchCardSelector);
      if(!cards.length){rendering=false;return;}

      const prepareList=[];
      for(const card of cards){
        const name=getCardName(card);if(!name)continue;
        const anchor=findInsertBefore(card);
        const wrap=ensureWrap(card,anchor);
        const cached=snap.get(name);
        if(cached&&( !CFG.hideUnlimited || cached.limitTxt!=='无限制'))renderBar(wrap,cached);
        else setSkeleton(wrap);
        prepareList.push({card,name,wrap});
      }

      const nodes=await getNodes();
      const mapByName=new Map(nodes.map(n=>[(n.name||'').trim(),n]));
      const needRecent=[];
      for(const item of prepareList){
        const node=mapByName.get(item.name);
        if(!node){snap.del(item.name);continue;}
        const limit=Number(node.traffic_limit||0);
        if(CFG.hideUnlimited&&!limit){const old=q(item.card,'.km-traffic-wrap');if(old)old.remove();snap.del(item.name);continue;}

        const up=Number(node?.stats?.net_total_up??NaN);
        const down=Number(node?.stats?.net_total_down??NaN);
        if(Number.isFinite(up)&&Number.isFinite(down)){
          const used=calcUsed(node.traffic_limit_type,up,down);
          const percent=limit>0?(used/limit)*100:0;
          const info={percent,usedTxt:fmtBytes(used),limitTxt:limit?fmtBytes(limit):'无限制',typeTxt:typeLabel(node.traffic_limit_type)};
          renderBar(item.wrap,info);snap.set(item.name,info);
        }else needRecent.push({...item,node,limit});
      }

      if(needRecent.length){
        await Promise.allSettled(needRecent.map(it=>limitRecent(async()=>{
          try{
            const {up,down}=await getUsedFromRecent(it.node.uuid);
            const used=calcUsed(it.node.traffic_limit_type,up,down);
            const percent=it.limit>0?(used/it.limit)*100:0;
            const info={percent,usedTxt:fmtBytes(used),limitTxt:it.limit?fmtBytes(it.limit):'无限制',typeTxt:typeLabel(it.node.traffic_limit_type)};
            renderBar(it.wrap,info);snap.set(it.name,info);
          }catch(e){log('recent failed:',it.node.name,e);}
        })));
      }
    }catch(e){console.warn('renderOnce failed:',e);}finally{rendering=false;}
  }

  /* ===== 触发机制 ===== */
  if(document.readyState==='loading'){
    document.addEventListener('readystatechange',()=>{if(document.readyState==='interactive')renderOnce();},{once:true});
  }else renderOnce();

  setInterval(renderOnce,CFG.refreshMs);
  const mo=new MutationObserver(()=>renderOnce());
  mo.observe(document.body,{childList:true,subtree:true});
  const _ps=history.pushState,_rs=history.replaceState;
  history.pushState=function(){_ps.apply(this,arguments);renderOnce();};
  history.replaceState=function(){_rs.apply(this,arguments);renderOnce();};
  window.addEventListener('popstate',renderOnce);
  window.addEventListener('hashchange',renderOnce);
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)renderOnce();});
  window.addEventListener('focus',renderOnce);
})();
</script>
