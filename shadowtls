wget https://github.com/shadowsocks/shadowsocks-rust/releases/download/v1.23.2/shadowsocks-v1.23.2.x86_64-unknown-linux-gnu.tar.xz
tar -xvf shadowsocks-v1.23.2.x86_64-unknown-linux-gnu.tar.xz
mv shadowsocks-v1.15.3.x86_64-unknown-linux-gnu/ssserver /usr/local/bin/
mkdir -p /etc/ss-rust
sing-box generate rand --base64 16
nano /etc/ss-rust/config.json
{
    "server": "0.0.0.0",
    "server_port": ss端口,
    "password": "ss密码",
    "method": "2022-blake3-aes-128-gcm",
    "fast_open": false
}

nano /etc/systemd/system/ss-rust.service
[Unit]
Description=Shadowsocks Rust Server
After=network.target

[Service]
ExecStart=/usr/local/bin/ssserver -c /etc/ss-rust/config.json
Restart=always
User=root

[Install]
WantedBy=multi-user.target

sudo systemctl enable ss-rust
sudo systemctl start ss-rust

wget https://github.com/ihciah/shadow-tls/releases/download/v0.2.25/shadow-tls-x86_64-unknown-linux-musl -O shadow-tls
chmod +x shadow-tls
mv shadow-tls /usr/local/bin/
nano /etc/systemd/system/shadowtls.service

[Unit]
Description=Shadow-TLS Server for SS2022
After=network.target

[Service]
ExecStart=/usr/local/bin/shadow-tls --v3 server \
  --listen ::0:443 \
  --server 127.0.0.1:ss端口 \
  --tls www.muji.com \
  --password stls密码
Restart=always
User=root

[Install]
WantedBy=multi-user.target

sudo systemctl enable shadowtls
sudo systemctl start shadowtls
